{
  "name": "traytunnel",
  "private": true,
  "license": "MIT",
  "description": "Windows tray SSH tunnel manager built with Tauri",
  "author": "Charlotte.HonG",
  "version": "0.6.6",
  "type": "module",
  "scripts": {
    "build:dist": "tauri build && node scripts/package.mjs",
    "build:mac": "tauri build --bundles app --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}' && node scripts/copy-app-bundle.mjs",
    "build:win:exe": "tauri build --no-bundle && node scripts/package.mjs",
    "build:win:setup": "tauri build --bundles nsis && node scripts/package.mjs",
    "bump": "node scripts/bump.mjs",
    "dev": "tauri dev",
    "release": "node scripts/release.mjs",
    "tauri": "tauri",
    "test:release": "node --test scripts/lib/*.test.mjs",
    "web:build": "tsc && vite build",
    "web:dev": "vite",
    "web:preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "lucide": "^1.33.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  }
}
