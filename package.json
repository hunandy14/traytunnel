{
  "name": "traytunnel",
  "private": true,
  "license": "MIT",
  "description": "Windows tray SSH tunnel manager built with Tauri",
  "author": "Charlotte.HonG",
  "version": "0.5.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:exe": "tauri build --no-bundle && node scripts/package.mjs",
    "build:setup": "tauri build --bundles nsis && node scripts/package.mjs",
    "build:all": "tauri build && node scripts/package.mjs",
    "bump": "node scripts/bump.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "lucide": "^1.33.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  }
}
