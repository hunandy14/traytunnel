# traytunnel 設定檔範本，複製成 traytunnel.toml 後放在執行檔同一個資料夾。
# 也可以直接在程式的設定介面填寫，存檔時會寫回這個檔案並保留註解。

host = "your-host.example.com"
user = "your-user"

# 不需要 ProxyCommand 時留空字串即可。
proxyCommand = "cloudflared access ssh --hostname %h"

# 關閉鈕（X）是否只隱藏到系統匣，false 代表直接結束程式。
closeToTray = true

# 每個 [[forwards]] 是一組本地埠轉發，第一個埠會用來判斷隧道是否連上。
[[forwards]]
name = "exit-a"
local = 1080
remote = "127.0.0.1:1080"

[[forwards]]
name = "exit-b"
local = 1083
remote = "127.0.0.1:1083"
