{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "traytunnel",
  "version": "0.2.0",
  "identifier": "com.traytunnel.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Traytunnel",
        "width": 464,
        "height": 448,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Settings",
        "url": "settings.html",
        "width": 436,
        "height": 514,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
