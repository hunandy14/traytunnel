{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Traytunnel",
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "Traytunnel",
        "width": 540,
        "height": 446,
        "minWidth": 480,
        "minHeight": 420,
        "resizable": true,
        "maximizable": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
